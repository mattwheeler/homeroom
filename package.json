{
  "name": "homeroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:migrate:local": "wrangler d1 migrations apply homeroom-build-week --local",
    "check:vinext": "vinext check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "security": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "verify:release": "npm run security && npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "jose": "^6.2.3",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.45.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "^19.2.7",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
